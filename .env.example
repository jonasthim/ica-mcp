# No ICA passwords: logins are BankID QR scans (see spike/README.md). Nothing secret goes here.
# Handla (Ocado) store id for the household's online store, from spike/06-handla-public
HANDLA_STORE_ID=
# Login start URL discovered from the HAR (Task 0.9)
HANDLA_LOGIN_START_URL=
# Optional override; defaults to the public DCR client credential distributed in ICA's app
# (it only permits client registration; login still needs BankID)
# ICA_APP_DCR_CLIENT_SECRET=
# Shopping-list write tools (add/check/uncheck/remove items, create a list). They change the household's real,
# shared ICA lists. off (default): the tools are not offered to Claude at all. all: every hub user with ICA access.
# Or a comma-separated list of hub user emails (any case), checked against each user's current email at call time;
# anyone else is told "List editing is not enabled for your account yet."
# ICA_HUB_LIST_WRITES=off
# App-token upkeep. interval (default): every connected ICA app session is refreshed about every 10 minutes, like
# the ICA app. on-demand: only when a tool needs it (fallback if a refresh is seen to end web purchase history).
# ICA_HUB_APP_UPKEEP=interval
# First-run admin, optional and first-start only: creates the first admin when the database has no users.
# Ignored as soon as any user exists — it never recreates a removed or renamed admin. Remove both after the first
# start, or skip them entirely and set up the first admin from /admin/setup instead.
# ICA_HUB_ADMIN_EMAIL=
# ICA_HUB_ADMIN_PASSWORD=
# A setup code you choose (12-64 letters/digits), accepted by first-run setup besides the one in the service log.
# Optional; useful for automated installs, or when LOG_LEVEL hides the logged code.
# ICA_HUB_SETUP_CODE=
# OIDC sign-in (Authentik), optional: set here only if you want it managed by the environment (read-only in
# Settings). Needs OIDC_ISSUER_URL, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET together — otherwise leave these unset
# and configure single sign-on on the Settings page instead.
# Password sign-in; false hides it everywhere (requires OIDC, or nobody could sign in).
# AUTH_LOCAL_LOGIN=true
# Link an existing ICA-MCP user to their first OIDC sign-in when the IdP verified the same email.
# This trusts the IdP's email_verified completely: link the existing admin once, then set it to false, unless the
# IdP really verifies email and users cannot change it (Authentik: check the email scope mapping's email_verified).
# OIDC_LINK_BY_EMAIL=true
# Group mapping (the `groups` claim; the provider needs a groups scope mapping). Members of the admin group are
# admins, of the member group members; a person in either group gets an account at their first sign-in (no invite).
# With a member group set, roles follow the groups both ways at every sign-in (the last admin is never demoted) and
# people in neither group cannot use single sign-on. With only the admin group set it only ever promotes.
# With both in env and an empty database, the first admin-group sign-in becomes the admin (no setup code needed).
# OIDC_ADMIN_GROUP=ica-hub-admins
# OIDC_MEMBER_GROUP=ica-hub-users
