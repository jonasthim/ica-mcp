{
  "name": "ica-hub",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "spike": "node --env-file-if-exists=.env --import tsx",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/admin/assets','dist/admin/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --config src/auth/config.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "auth": "1.7.6",
    "axe-core": "^4.13.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "jsdom": "^30.1.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "0.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.6",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@modelcontextprotocol/express": "2.0.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "fetch-cookie": "^3.2.0",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "tough-cookie": "^6.0.2",
    "zod": "4.6.5"
  }
}
